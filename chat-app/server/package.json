{
  "name": "whatsapp_web_js",
  "version": "1.0.0",
  "main": "src/server.ts",
  "repository": "https://github.com/Hamza-Qureshi09/whatsapp_web_js.git",
  "author": "Hamza Qureshi",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=50 npm run build && node dist/server.js",
    "dev": "cross-env UV_THREADPOOL_SIZE=20 nodemon",
    "format:fix": "prettier . --check --write --ignore-path .prettierignore",
    "build": "tsc",
    "prepare": "husky",
    "docker:publish": "docker build -t hamzaqureshi09/etihad-api-hq29:v1 --platform linux/amd64 -f Dockerfile.prod . && docker push hamzaqureshi09/etihad-api-hq29:v1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run format:fix"
    ],
    "**/*.{js,ts,jsx,tsx,json,css,scss,md}": [
      "npm run format:fix"
    ]
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.7",
    "morgan": "^1.10.0",
    "prettier": "^3.4.2",
    "rate-limit-redis": "^4.2.0",
    "rate-limiter-flexible": "^5.0.5",
    "ts-node": "^10.9.2",
    "validator": "^13.12.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/parse": "^19.5.0",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.1",
    "@types/validator": "^13.12.2",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.3"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": ".js, .ts",
    "exec": "ts-node src/server.ts",
    "ignore": [
      "node_modules",
      "dist",
      "**/__tests__/*",
      "**/*.spec.ts"
    ]
  }
}
