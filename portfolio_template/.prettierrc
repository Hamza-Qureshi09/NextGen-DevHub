{
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": true,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "arrowParens": "always",
    "bracketSpacing": true,
    "quoteProps": "consistent",
    "printWidth": 80,
    "endOfLine": "lf",
    "overrides": [
        {
          "files": "*.json",
          "options": {
            "printWidth": 120
          }
        }
      ]
  }