{
  "name": "access-system",
  "version": "1.0.0",
  "description": "Scalable Access Control System",
  "main": "src/server.ts",
  "author": "Hamza Qureshi",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=50 npm run build && node dist/server.js",
    "dev": "cross-env UV_THREADPOOL_SIZE=20 nodemon",
    "format:fix": "prettier . --check --write --ignore-path .prettierignore",
    "build": "tsc",
    "prepare": "husky",
    "docker:publish": "docker build -t hamzaqureshi09/etihad-api-hq29:v1 --platform linux/amd64 -f Dockerfile.prod . && docker push hamzaqureshi09/etihad-api-hq29:v1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run format:fix"
    ],
    "**/*.{js,ts,jsx,tsx,json,css,scss,md}": [
      "npm run format:fix"
    ]
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "prettier": "^3.5.3",
    "rate-limit-redis": "^4.2.0",
    "rate-limiter-flexible": "^7.1.1",
    "ts-node": "^10.9.2",
    "validator": "^13.15.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/parse": "^19.8.1",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.19",
    "@types/validator": "^13.15.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  }
}
